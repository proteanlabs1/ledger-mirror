  galen(["Galen\nproposal only\nzero on-chain roles"])
  approval(["Operator approval\nsingle-use token\nreview_record_id"])
  galen --> approval --> bankr
  operator -.approval + operational roles.-> approval
  bankr   -.approved automated writes.-> proxy

  subgraph offchain["Off-chain"]
